# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
app/build/

# Android / IntelliJ / Android Studio
*.iml
.idea/
.kotlin/
local.properties
captures/
.externalNativeBuild/
.cxx/

# 签名密钥：发布密钥切勿提交；
# keystore/debug.keystore 为固定调试密钥（标准公知密码 android），
# 特意入库以保证 CI 每次构建的 debug APK 签名一致、可覆盖安装。
*.jks
*.keystore
!keystore/debug.keystore
keystore.properties

# 系统文件
.DS_Store
*.log

# 本地离线资料与临时分析产物（不入库）：
# third_party/ 存放图标源码包等参考包（使用说明见 third_party/README.md）；
# .apk-analysis/ 为本地 APK 解包分析工作目录。
/third_party/
/.apk-analysis/
